# Server Port
PORT=3000

# Pre-shared secret key for X-API-Key header validation
# Leave blank in local dev to disable auth, or set a strong secret for homelab/VPS exposure
API_KEY=my_super_secret_key_123

# SQLite Database File Path
DB_PATH=./data/attendance.db

# User Timezone (IANA format, e.g. Asia/Kolkata, America/New_York, UTC)
TIMEZONE=Asia/Kolkata
